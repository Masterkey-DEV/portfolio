---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { FaExternalLinkAlt, FaGithub } from "react-icons/fa";

const webProjects = [
  {
    title: "PT Jaya Persada Bali - Sistema Contable",
    category: "Aplicacion Web",
    featured: true,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/mze0vfpmxeecdvv8srbq",
    description: "Sistema contable web especializado para un money changer con seguimiento preciso de transacciones en multiples monedas y valoracion de inventario FIFO.",
    technologies: ["Next.js", "TypeScript", "Supabase", "Tailwind CSS"],
    liveUrl: "https://pt-jaya-persada-bali.vercel.app/",
  },
  {
    title: "PT BRO Bali Tour and Travel",
    category: "Aplicacion Web",
    featured: true,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/kj4f9fvpmlyx7h1mpi4m",
    description: "Sistema contable automatizado reemplazando procesos manuales en Excel por una solucion segura, estandarizada y con reportes financieros dinamicos.",
    technologies: ["React", "Node.js", "PostgreSQL", "Express"],
    liveUrl: "https://ptbro-accounting-app.vercel.app/",
  },
  {
    title: "Sakura Spa Banyuwangi",
    category: "Aplicacion Web",
    featured: false,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/lnmbtrny1gi3bktv2nqi",
    description: "Sistema de reservas, programacion y POS con reservas en linea, gestion de transacciones y una interfaz adaptable.",
    technologies: ["Next.js", "Prisma", "PostgreSQL", "Tailwind CSS"],
    liveUrl: "https://sakuraspabwi.com/",
  },
  {
    title: "CV. Bapak Anak Jaya Abadi",
    category: "Landing Page",
    featured: true,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/pc3snehphit7ekjncreh",
    description: "Landing page corporativa para un lider en venta y alquiler de maquinaria pesada, con animaciones fluidas y diseno responsivo.",
    technologies: ["Next.js", "Tailwind CSS", "Framer Motion"],
    liveUrl: "https://www.cvbapakanakjayaabadi.com/",
  },
  {
    title: "Laboratorio de Paz",
    category: "Sitio Web",
    featured: false,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/mze0vfpmxeecdvv8srbq",
    description: "Sitio web para la fundacion Laboratorio de Paz, Convivencia y Seguridad Humana, una iniciativa social con impacto real en Colombia.",
    technologies: ["Astro", "Tailwind CSS", "JavaScript"],
    liveUrl: "#",
  },
  {
    title: "E-commerce Dashboard",
    category: "Aplicacion Web",
    featured: false,
    image: "https://res.cloudinary.com/dpvhwdmon/image/upload/f_auto,q_auto/v1/portfolio-projects/kj4f9fvpmlyx7h1mpi4m",
    description: "Panel de administracion para tiendas en linea con analiticas en tiempo real, gestion de inventario y reportes de ventas.",
    technologies: ["React", "Chart.js", "Node.js", "MongoDB"],
    liveUrl: "#",
  },
];

const categories = ["Todos", "Aplicacion Web", "Landing Page", "Sitio Web"];
---

<Layout>
  <main class="pt-28 pb-16 px-6 lg:px-12">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 fade-in">
        <h1 class="text-4xl sm:text-5xl font-bold text-foreground mb-4">
          Proyectos Web
        </h1>
        <div class="w-20 h-1 bg-primary mx-auto rounded-full mb-6"></div>
        <p class="text-muted-foreground max-w-2xl mx-auto text-lg">
          Una coleccion de proyectos web que he desarrollado, desde aplicaciones empresariales hasta landing pages modernas.
        </p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12 fade-in">
        {categories.map((category, index) => (
          <button
            class={`px-5 py-2 rounded-lg font-medium transition-colors ${
              index === 0
                ? "bg-primary text-primary-foreground"
                : "bg-secondary text-secondary-foreground hover:bg-muted"
            }`}
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 fade-in">
        {webProjects.map((project) => (
          <article class="group bg-card border border-border rounded-2xl overflow-hidden hover:border-primary/50 hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 flex flex-col">
            <div class="relative h-48 overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {project.featured && (
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-primary text-primary-foreground">
                    Destacado
                  </span>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-card to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-6 gap-3">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors"
                >
                  <FaExternalLinkAlt className="w-3 h-3" />
                  Ver sitio
                </a>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <span class="text-xs font-medium text-primary mb-2">
                {project.category}
              </span>
              <h3 class="text-lg font-semibold text-card-foreground mb-3 group-hover:text-primary transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-muted-foreground mb-4 flex-1">
                {project.description}
              </p>
              
              <div class="flex flex-wrap gap-2 mt-auto">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-2 py-1 rounded-md bg-secondary text-secondary-foreground">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA Section -->
      <div class="mt-20 text-center fade-in">
        <div class="bg-card border border-border rounded-2xl p-8 md:p-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-card-foreground mb-4">
            Tienes un proyecto en mente?
          </h2>
          <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
            Estoy disponible para nuevos proyectos. Contactame y hablemos sobre como puedo ayudarte a hacer realidad tu idea.
          </p>
          <a
            href="/#contacto"
            class="inline-flex items-center px-8 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
          >
            Contactar
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll('[data-category]');
  const projects = document.querySelectorAll('article');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active state
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-primary-foreground');
        btn.classList.add('bg-secondary', 'text-secondary-foreground');
      });
      button.classList.remove('bg-secondary', 'text-secondary-foreground');
      button.classList.add('bg-primary', 'text-primary-foreground');

      const category = button.getAttribute('data-category');
      
      projects.forEach(project => {
        const projectCategory = project.querySelector('.text-primary')?.textContent;
        if (category === 'Todos' || projectCategory === category) {
          project.style.display = '';
        } else {
          project.style.display = 'none';
        }
      });
    });
  });
</script>
