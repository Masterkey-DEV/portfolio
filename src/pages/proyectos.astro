---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { FaExternalLinkAlt, FaGithub } from "react-icons/fa";

const webProjects = [
  {
    title: "MCM Servicios de Limpieza",
    category: "Aplicacion Web",
    featured: true,
    image: "https://picsum.photos/seed/clean-service-app/800/500",
    description: "Plataforma web de reservas para una empresa de limpieza, con Next.js, Tailwind y Framer Motion, e integración de calendario para agendar servicios.",
    technologies: ["Next.js", "TypeScript", "Tailwind CSS", "Framer Motion"],
    liveUrl: "https://clean-service-app-iota.vercel.app/",
    githubUrl: "https://github.com/Masterkey-DEV/clean-service-app",
  },
  {
    title: "RestoPro - Sistema de Restaurante",
    category: "Aplicacion Web",
    featured: true,
    image: "https://picsum.photos/seed/restopro/800/500",
    description: "Sistema full-stack de gestión de restaurantes 100% offline-capaz (local-first): backend en Rust + SQLite, frontend en Next.js y autenticación JWT.",
    technologies: ["Next.js", "Rust", "SQLite", "TypeScript", "Tauri"],
    liveUrl: "https://github.com/Masterkey-DEV/restaurante",
  },
  {
    title: "Memoria y Verdad",
    category: "Aplicacion Web",
    featured: true,
    image: "https://picsum.photos/seed/vitrina-social/800/500",
    description: "Plataforma social para visibilizar y preservar la memoria de una comunidad, con perfiles, publicaciones y un diseño responsive.",
    technologies: ["Next.js", "TypeScript", "Tailwind CSS"],
    liveUrl: "https://memoria-y-verdad.vercel.app/",
    githubUrl: "https://github.com/Masterkey-DEV/vitrina-social",
  },
  {
    title: "La Potente",
    category: "Sitio Web",
    featured: true,
    image: "https://picsum.photos/seed/scrasi/800/500",
    description: "Sitio web corporativo para un negocio local, desarrollado con Astro, con diseño moderno, animaciones y despliegue en producción.",
    technologies: ["Astro", "TypeScript", "Tailwind CSS"],
    liveUrl: "https://lapotente.vercel.app/",
    githubUrl: "https://github.com/Masterkey-DEV/scrasi",
  },
  {
    title: "Shop Backend - Ecommerce",
    category: "Backend",
    featured: true,
    image: "https://picsum.photos/seed/shop-backend/800/500",
    description: "Backend para ecommerce online de presentación, construido con NestJS, Prisma y PostgreSQL, con autenticación JWT y arquitectura modular.",
    technologies: ["NestJS", "Prisma", "PostgreSQL", "TypeScript"],
    liveUrl: "https://github.com/Masterkey-DEV/shop-backend",
  },
  {
    title: "Facturación Electrónica DIAN",
    category: "Backend",
    featured: false,
    image: "https://picsum.photos/seed/facturas/800/500",
    description: "API de facturación electrónica colombiana (DIAN) desarrollada en Python con FastAPI, que genera y valida documentos UBL 2.1.",
    technologies: ["Python", "FastAPI", "UBL 2.1", "XML"],
    liveUrl: "https://github.com/Masterkey-DEV/facturas",
  },
  {
    title: "Scrappii - Extensión de Navegador",
    category: "Herramienta",
    featured: false,
    image: "https://picsum.photos/seed/scrappii/800/500",
    description: "Extensión de navegador (Chrome/Firefox) para scrapear productos de eBay, descargar imágenes en alta resolución y prepararlos para reventa en Colombia con conversión de moneda.",
    technologies: ["JavaScript", "Chrome Extensions", "Web Scraping"],
    liveUrl: "https://github.com/Masterkey-DEV/scrappii",
  },
  {
    title: "Zapatería Online",
    category: "Sitio Web",
    featured: false,
    image: "https://picsum.photos/seed/zapateria/800/500",
    description: "Tienda en línea de zapatos construida con Next.js y TypeScript, con catálogo de productos y despliegue en Vercel.",
    technologies: ["Next.js", "TypeScript", "Tailwind CSS"],
    liveUrl: "https://zapateria-nu.vercel.app/",
    githubUrl: "https://github.com/Masterkey-DEV/zapateria",
  },
  {
    title: "Laboratorio de Paz",
    category: "Sitio Web",
    featured: false,
    image: "https://picsum.photos/seed/laboratorio-paz/800/500",
    description: "Plataforma para la Fundación Laboratorio de Paz, Convivencia y Seguridad Humana, con sistema de usuarios, publicaciones y panel de administración.",
    technologies: ["TypeScript", "Astro", "Node.js"],
    liveUrl: "https://github.com/Masterkey-DEV/laboratorio-de-paz-frontend",
  },
  {
    title: "Página About - RestoPro",
    category: "Sitio Web",
    featured: false,
    image: "https://picsum.photos/seed/pagina-about-restapro/800/500",
    description: "Landing/about page para el sistema RestoPro, construida con Astro y desplegada en Vercel, para presentar el proyecto y su propuesta.",
    technologies: ["Astro", "TypeScript"],
    liveUrl: "https://pagina-about-restapro.vercel.app/",
    githubUrl: "https://github.com/Masterkey-DEV/pagina-about-restapro",
  },
  {
    title: "Node Movies REST API",
    category: "Backend",
    featured: false,
    image: "https://picsum.photos/seed/node-movies/800/500",
    description: "API REST para gestionar un catálogo de películas, desarrollada con Node.js, Express y una base de datos SQL.",
    technologies: ["Node.js", "Express", "SQL"],
    liveUrl: "https://github.com/Masterkey-DEV/node-movies-rest-api",
  },
  {
    title: "Python Music API",
    category: "Backend",
    featured: false,
    image: "https://picsum.photos/seed/python-music/800/500",
    description: "API para servir música construida en Python usando FastAPI, con rutas y documentación de la interfaz REST.",
    technologies: ["Python", "FastAPI"],
    liveUrl: "https://github.com/Masterkey-DEV/python-music-API",
  },
];

const categories = ["Todos", "Aplicacion Web", "Sitio Web", "Backend", "Herramienta"];
---

<Layout>
  <main class="pt-28 pb-16 px-6 lg:px-12">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16 fade-in">
        <h1 class="text-4xl sm:text-5xl font-bold text-foreground mb-4">
          Proyectos Web
        </h1>
        <div class="w-20 h-1 bg-primary mx-auto rounded-full mb-6"></div>
        <p class="text-muted-foreground max-w-2xl mx-auto text-lg">
          Una coleccion de proyectos web que he desarrollado, desde aplicaciones empresariales hasta landing pages modernas.
        </p>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12 fade-in">
        {categories.map((category, index) => (
          <button
            class={`px-5 py-2 rounded-lg font-medium transition-colors ${
              index === 0
                ? "bg-primary text-primary-foreground"
                : "bg-secondary text-secondary-foreground hover:bg-muted"
            }`}
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 fade-in">
        {webProjects.map((project) => (
          <article class="group bg-card border border-border rounded-2xl overflow-hidden hover:border-primary/50 hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 flex flex-col">
            <div class="relative h-48 overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {project.featured && (
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1 rounded-full text-xs font-medium bg-primary text-primary-foreground">
                    Destacado
                  </span>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-card to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-6 gap-3">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors"
                >
                  <FaExternalLinkAlt className="w-3 h-3" />
                  Ver proyecto
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 bg-card text-card-foreground px-4 py-2 rounded-lg text-sm font-medium hover:bg-secondary transition-colors"
                  >
                    <FaGithub className="w-3 h-3" />
                    Código
                  </a>
                )}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <span class="text-xs font-medium text-primary mb-2">
                {project.category}
              </span>
              <h3 class="text-lg font-semibold text-card-foreground mb-3 group-hover:text-primary transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-muted-foreground mb-4 flex-1">
                {project.description}
              </p>
              
              <div class="flex flex-wrap gap-2 mt-auto">
                {project.technologies.map((tech) => (
                  <span class="text-xs px-2 py-1 rounded-md bg-secondary text-secondary-foreground">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA Section -->
      <div class="mt-20 text-center fade-in">
        <div class="bg-card border border-border rounded-2xl p-8 md:p-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-card-foreground mb-4">
            Tienes un proyecto en mente?
          </h2>
          <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
            Estoy disponible para nuevos proyectos. Contactame y hablemos sobre como puedo ayudarte a hacer realidad tu idea.
          </p>
          <a
            href="/#contacto"
            class="inline-flex items-center px-8 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
          >
            Contactar
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll('[data-category]');
  const projects = document.querySelectorAll('article');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active state
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-primary-foreground');
        btn.classList.add('bg-secondary', 'text-secondary-foreground');
      });
      button.classList.remove('bg-secondary', 'text-secondary-foreground');
      button.classList.add('bg-primary', 'text-primary-foreground');

      const category = button.getAttribute('data-category');
      
      projects.forEach(project => {
        const projectCategory = project.querySelector('.text-primary')?.textContent;
        if (category === 'Todos' || projectCategory === category) {
          project.style.display = '';
        } else {
          project.style.display = 'none';
        }
      });
    });
  });
</script>
