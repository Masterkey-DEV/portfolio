---
import Social from "../Social.astro";
import { BsTwitterX } from "react-icons/bs";
import { FaSquareFacebook } from "react-icons/fa6";
import { GrLinkedin } from "react-icons/gr";
import { FaGithub } from "react-icons/fa";
import { IoMdMailUnread } from "react-icons/io";
---

<div
  class="w-full flex flex-wrap items-center justify-center md:justify-start gap-2 mt-1"
>
  <Social href="https://twitter.com" Logo={BsTwitterX} social="Twitter" />
  <Social
    href="https://facebook.com"
    Logo={FaSquareFacebook}
    social="Facebook"
  />
  <Social href="https://www.linkedin.com/in/el-mejor-dev-para-ti/" Logo={GrLinkedin} social="LinkedIn" />
  <Social href="https://github.com/Masterkey-DEV" Logo={FaGithub} social="GitHub" />
  <Social
    href="mailto:juansebastianmoreno4.0@gmail.com"
    Logo={IoMdMailUnread}
    social="Email"
  />
</div>
