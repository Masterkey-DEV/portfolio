---
import { IoClose, IoMenu, IoHome, IoPerson, IoBriefcase, IoMail, IoCodeSlash } from "react-icons/io5";
import { MdNightlight } from "react-icons/md";
import { CiLight } from "react-icons/ci";
---

<header
  class="w-full h-20 bg-background/80 backdrop-blur-lg border-b border-border flex px-6 lg:px-12 py-4 justify-between items-center fixed top-0 z-50 transition-colors"
>
  <div
    id="menu-backdrop"
    class="absolute bg-primary/10 rounded-lg transition-all duration-300 ease-out opacity-0 pointer-events-none z-0"
  >
  </div>

  <div class="flex items-center gap-4">
    <a class="logo hover:cursor-pointer transition-colors z-10 group" href="/">
      <h3 class="text-xl font-semibold text-foreground group-hover:text-primary transition-colors">
        Juan Moreno
      </h3>
    </a>
    <button
      id="darkMode"
      aria-label="Cambiar modo oscuro"
      class="flex h-9 w-9 items-center justify-center rounded-lg bg-secondary text-secondary-foreground transition-colors hover:bg-muted"
    >
      <CiLight className="dark:hidden w-5 h-5" />
      <MdNightlight className="hidden dark:block w-5 h-5" />
    </button>
  </div>

  <nav class="nav-bar z-10">
    <ul class="list-none hidden md:flex gap-1">
      <li>
        <a class="nav-link px-4 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors" href="/">
          Inicio
        </a>
      </li>
      <li>
        <a class="nav-link px-4 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors" href="/#sobre-mi">
          Sobre mi
        </a>
      </li>
      <li>
        <a class="nav-link px-4 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors" href="/proyectos">
          Proyectos
        </a>
      </li>
      <li>
        <a class="nav-link px-4 py-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors" href="/#contacto">
          Contacto
        </a>
      </li>
      <li>
        <a 
          class="ml-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors" 
          href="/JuanMoreno.pdf" 
          download="JuanMorenoCV.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
        >
          Descargar CV
        </a>
      </li>
    </ul>

    <button
      id="open-menu"
      class="md:hidden p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors"
      aria-label="Abrir menu"
    >
      <IoMenu size={24} />
    </button>
  </nav>
</header>

<!-- Mobile overlay -->
<div
  id="menu-overlay"
  class="fixed inset-0 bg-foreground/20 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-[998]"
>
</div>

<!-- Mobile menu -->
<aside
  id="mobile-menu"
  class="fixed top-0 right-0 w-72 h-full bg-card shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col p-6 z-[999]"
>
  <div class="flex justify-between items-center mb-10">
    <span class="text-lg font-semibold text-card-foreground">Menu</span>
    <button
      id="close-menu"
      class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors"
      aria-label="Cerrar menu"
    >
      <IoClose size={24} />
    </button>
  </div>

  <ul class="flex flex-col gap-2 text-card-foreground">
    <li>
      <a
        href="/"
        class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-secondary transition-colors"
      >
        <IoHome class="text-primary" />
        <span>Inicio</span>
      </a>
    </li>
    <li>
      <a
        href="/#sobre-mi"
        class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-secondary transition-colors"
      >
        <IoPerson class="text-primary" />
        <span>Sobre mi</span>
      </a>
    </li>
    <li>
      <a
        href="/proyectos"
        class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-secondary transition-colors"
      >
        <IoCodeSlash class="text-primary" />
        <span>Proyectos</span>
      </a>
    </li>
    <li>
      <a
        href="/#contacto"
        class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-secondary transition-colors"
      >
        <IoMail class="text-primary" />
        <span>Contacto</span>
      </a>
    </li>
  </ul>

  <div class="mt-auto pt-6 border-t border-border">
    <a
      href="/JuanMoreno.pdf"
      download="JuanMorenoCV.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
    >
      <IoBriefcase />
      <span>Descargar CV</span>
    </a>
  </div>
</aside>

<script>
  const openMenu = document.getElementById("open-menu")!;
  const closeMenu = document.getElementById("close-menu")!;
  const mobileMenu = document.getElementById("mobile-menu")!;
  const overlay = document.getElementById("menu-overlay")!;

  const open = () => {
    mobileMenu.classList.remove("translate-x-full");
    overlay.classList.remove("opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    mobileMenu.classList.add("translate-x-full");
    overlay.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
  };

  openMenu.addEventListener("click", open);
  closeMenu.addEventListener("click", close);
  overlay.addEventListener("click", close);

  // Close on ESC key
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });

  // Close on link click
  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", close);
  });

  // Menu backdrop effect for desktop
  const listItems = document.querySelectorAll(".nav-link, .logo");
  const menuBackdrop = document.getElementById("menu-backdrop")!;
  let timeoutId: ReturnType<typeof setTimeout>;

  listItems.forEach((item) => {
    item.addEventListener("mouseenter", () => {
      const { left, top, width, height } = item.getBoundingClientRect();

      Object.assign(menuBackdrop.style, {
        left: `${left}px`,
        top: `${top}px`,
        width: `${width}px`,
        height: `${height}px`,
        opacity: "1",
        visibility: "visible",
      });

      clearTimeout(timeoutId);
    });

    item.addEventListener("mouseleave", () => {
      timeoutId = setTimeout(() => {
        menuBackdrop.style.opacity = "0";
        menuBackdrop.style.visibility = "hidden";
      }, 200);
    });
  });

  menuBackdrop.addEventListener("mouseenter", () => clearTimeout(timeoutId));
  menuBackdrop.addEventListener("mouseleave", () => {
    menuBackdrop.style.opacity = "0";
    menuBackdrop.style.visibility = "hidden";
  });
</script>
