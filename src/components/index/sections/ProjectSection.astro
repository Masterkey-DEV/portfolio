---
import ProjectCard from "../cards/ProjectCard.astro";

const projects = [
  {
    title: "MCM Servicios de Limpieza",
    tags: ["Aplicación Web", "Destacado"],
    image: "https://picsum.photos/seed/clean-service-app/800/500",
    description:
      "Plataforma web de reservas para una empresa de limpieza, con Next.js, Tailwind y Framer Motion, e integración de calendario para agendar servicios.",
    detailsUrl: "https://github.com/Masterkey-DEV/clean-service-app",
    liveUrl: "https://clean-service-app-iota.vercel.app/",
  },
  {
    title: "RestoPro - Gestión de Restaurante",
    tags: ["Aplicación Web", "Destacado"],
    image: "https://picsum.photos/seed/restopro/800/500",
    description:
      "Sistema full-stack de gestión de restaurantes 100% offline-capaz (local-first), con backend en Rust + SQLite y frontend en Next.js.",
    detailsUrl: "https://github.com/Masterkey-DEV/restaurante",
    liveUrl: "https://github.com/Masterkey-DEV/restaurante",
  },
  {
    title: "Memoria y Verdad",
    tags: ["Aplicación Web"],
    image: "https://picsum.photos/seed/vitrina-social/800/500",
    description:
      "Plataforma social para visibilizar y preservar la memoria de una comunidad, con perfiles, publicaciones y diseño responsive.",
    detailsUrl: "https://github.com/Masterkey-DEV/vitrina-social",
    liveUrl: "https://memoria-y-verdad.vercel.app/",
  },
  {
    title: "La Potente",
    tags: ["Sitio Web", "Destacado"],
    image: "https://picsum.photos/seed/scrasi/800/500",
    description:
      "Sitio web corporativo para un negocio local, desarrollado con Astro, con diseño moderno, animaciones y despliegue en producción.",
    detailsUrl: "https://github.com/Masterkey-DEV/scrasi",
    liveUrl: "https://lapotente.vercel.app/",
  },
];
---

<section
  class="py-20 bg-white dark:bg-black transition-colors fade-in"
  id="proyectos"
>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
        Proyectos Seleccionados
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Soluciones reales para negocios reales — desde plataformas de IA hasta
        sistemas financieros
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>

    <div class="text-center">
      <a
        href="/Portfolio"
        class="inline-flex items-center text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium transition group"
      >
        Ver todos los proyectos de desarrollo web
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
