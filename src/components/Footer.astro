---
import { FaGithub, FaLinkedin, FaEnvelope, FaHeart } from "react-icons/fa";
---

<footer class="border-t border-border py-12 px-6 lg:px-12 bg-background">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Logo & Copyright -->
      <div class="text-center md:text-left">
        <a href="/" class="text-xl font-semibold text-foreground hover:text-primary transition-colors">
          Juan Moreno
        </a>
        <p class="mt-2 text-sm text-muted-foreground">
          Desarrollador Full Stack
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Cali, Colombia - Clientes en todo el mundo
        </p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-sm">
        <a href="/" class="text-muted-foreground hover:text-foreground transition-colors">
          Inicio
        </a>
        <a href="/#sobre-mi" class="text-muted-foreground hover:text-foreground transition-colors">
          Sobre mi
        </a>
        <a href="/proyectos" class="text-muted-foreground hover:text-foreground transition-colors">
          Proyectos
        </a>
        <a href="/#contacto" class="text-muted-foreground hover:text-foreground transition-colors">
          Contacto
        </a>
      </nav>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/Masterkey-DEV"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
          aria-label="GitHub"
        >
          <FaGithub className="w-5 h-5" />
        </a>
        <a
          href="https://www.linkedin.com/in/el-mejor-dev-para-ti/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
          aria-label="LinkedIn"
        >
          <FaLinkedin className="w-5 h-5" />
        </a>
        <a
          href="mailto:juansebastianmoreno4.0@gmail.com"
          class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
          aria-label="Email"
        >
          <FaEnvelope className="w-5 h-5" />
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Juan Moreno. Todos los derechos reservados.
      </p>
      <p class="text-sm text-muted-foreground flex items-center gap-1">
        Hecho con <FaHeart className="w-4 h-4 text-red-500" /> en Colombia
      </p>
    </div>
  </div>
</footer>
