---
import { FaLinkedin, FaGithub, FaEnvelope, FaWhatsapp } from "react-icons/fa";
---

<section id="contacto" class="py-24 px-6 lg:px-12 bg-secondary/30">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-16 fade-in">
      <h2 class="text-3xl sm:text-4xl font-bold text-foreground mb-4">
        Contacto
      </h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full mb-6"></div>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        Si estas buscando colaboracion o simplemente quieres saludar, estare encantado de responder.
      </p>
    </div>

    <div class="bg-card border border-border rounded-2xl p-8 md:p-12 text-center fade-in">
      <h3 class="text-2xl font-semibold text-card-foreground mb-4">
        Trabajemos juntos
      </h3>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        Estoy disponible para proyectos freelance, colaboraciones y oportunidades de trabajo remoto. 
        No dudes en contactarme.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
        <a
          href="mailto:juan@example.com"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
        >
          <FaEnvelope className="w-5 h-5" />
          Enviar correo
        </a>
        <a
          href="https://wa.me/573001234567"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-lg border border-border text-foreground font-medium hover:bg-secondary transition-colors"
        >
          <FaWhatsapp className="w-5 h-5" />
          WhatsApp
        </a>
      </div>

      <div class="border-t border-border pt-8">
        <p class="text-sm text-muted-foreground mb-4">O encuentrame en redes sociales</p>
        <div class="flex items-center justify-center gap-6">
          <a
            href="https://linkedin.com/in/juan-sebastian"
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
            aria-label="LinkedIn"
          >
            <FaLinkedin className="w-5 h-5" />
          </a>
          <a
            href="https://github.com/juan-sebastian"
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
            aria-label="GitHub"
          >
            <FaGithub className="w-5 h-5" />
          </a>
          <a
            href="mailto:juan@example.com"
            class="w-12 h-12 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground hover:text-primary hover:bg-primary/10 transition-colors"
            aria-label="Email"
          >
            <FaEnvelope className="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center fade-in">
      <p class="text-muted-foreground">
        Basado en <span class="text-foreground font-medium">Cali, Colombia</span> - Disponible para clientes en todo el mundo
      </p>
    </div>
  </div>
</section>
